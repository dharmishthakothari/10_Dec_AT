<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Parallel execution enabled via TestNG. Leveraging deep granular method-level concurrency. -->
<suite name="Automation Test Suite" parallel="methods" thread-count="4" data-provider-thread-count="3">

    <!-- Listener Hook connecting Extent Reports -->
    <listeners>
        <listener class-name="com.automation.listeners.TestListener" />
    </listeners>

    <test name="Practice Site Tests">
        <!-- Defined the execution paths for our scripts -->
        <classes>
            <class name="com.automation.tests.PracticeTests" />
        </classes>
    </test>
</suite>
